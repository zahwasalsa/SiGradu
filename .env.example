# Supabase project connection for Sigradu.
# Copy this file to `.env.local` and fill in the real values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

# Project API URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side ONLY, never prefix with NEXT_PUBLIC_, never send to the client.
# Only needed for privileged server actions that must bypass RLS (e.g. generating the graduation
# book PDF across all students in a period). Leave empty until such a server action needs it.
SUPABASE_SERVICE_ROLE_KEY=
